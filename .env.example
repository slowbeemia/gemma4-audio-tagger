# llama-server endpoint (default: localhost:8001)
LLAMA_SERVER_URL=http://localhost:8001

# SMB share for audio assets (TheGrey can reach Orange directly)
SMB_HOST=orange
SMB_USER=hermesbot
SMB_PASS=

# Asset Manager API on Bob (for status reporting)
ASSET_MANAGER_URL=http://bob.fritz.box:8899

# Tagging config
AUDIO_EXTENSIONS=.wav,.mp3,.ogg,.flac
BATCH_SIZE=10
DELAY_SEC=2
