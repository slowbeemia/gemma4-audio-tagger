# Asset Manager API (Bob)
ASSET_MANAGER_URL=http://bob.fritz.box:8899

# Gemini Model
GEMINI_MODEL=gemini-3.5-flash
# GOOGLE_API_KEY wird automatisch aus ~/.hermes/.env geladen

# Tagging config
DELAY_SEC=3
API_PAGE_SIZE=50
DAILY_LIMIT=1500

# Path mapping (SMB → local mount)
PATH_MAP_FROM=//orange/Assets
PATH_MAP_TO=/mnt/orange

# --- Legacy (llama.cpp, nur für tagger.py auf TheGrey) ---
LLAMA_SERVER_URL=http://localhost:8001
